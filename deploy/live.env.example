# Trenchscope server environment: the complete reference, filled for the LIVE
# deployment (real chains, real funds). Copy to deploy/live.env (compose),
# /etc/trenchscope/live.env (systemd) or `fly secrets set` (Fly.io), then
# `chmod 600`. Never commit the copy; no value below is a real secret.
#
# Unset optional values keep the server default (shown in brackets). Live-mode
# pieces that are missing do not stop the server: the features that need them
# stay off and the reasons are logged at boot and counted by /readyz.

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# The commented values in this block are set by the deployment (the image, docker-compose.yml,
# fly.*.toml or the systemd unit); uncomment one only to override it there.
#
# live = real chains and embedded wallets; demo = simulator + paper trading [demo].
# MODE=live
# production refuses development-only shortcuts such as LOCAL_KEYSTORE_KEY [production in the image].
# NODE_ENV=production
# Listen address [8787 / 0.0.0.0]. On one host without containers give each deployment its own PORT.
# PORT=8787
# HOST=0.0.0.0
# Snapshots, the SQLite store (trenchscope.db) and local backups [.data; /data in the image].
# One directory per deployment: a live server never loads a demo snapshot (and back).
# DATA_DIR=/data
# Built web app to serve [apps/web/dist when built; /app/apps/web/dist in the image].
# WEB_DIST=/app/apps/web/dist
# Reverse proxies in front whose X-Forwarded-For entries are trusted: 1 = one proxy (Caddy, Fly) [off].
# Without it behind a proxy every client shares the proxy's IP for the per-IP limits below; with it
# and the port reachable directly, clients could pick their own IP: expose the port only to the proxy.
# TRUST_PROXY=1
# Public URL of the demo deployment, linked from the live UI [none].
DEMO_URL=https://demo.example.com

# -----------------------------------------------------------------------------
# Persistence (snapshots of the world, accounts, orders, analytics)
# -----------------------------------------------------------------------------
# Periodic snapshot cadence in ms; also written on shutdown and restored at boot; 0 = off [900000].
SNAPSHOT_EVERY_MS=900000

# -----------------------------------------------------------------------------
# Abuse limits (per client IP; need TRUST_PROXY behind a proxy)
# -----------------------------------------------------------------------------
# Guest/register calls per 10 minutes [30].
ACCOUNT_CREATIONS_PER_IP=30
# Sign-in attempts per 10 minutes, any username; 0 = unlimited [60].
LOGIN_ATTEMPTS_PER_IP=60
# Concurrent WebSocket connections; 0 = unlimited [20].
WS_CONNECTIONS_PER_IP=20

# -----------------------------------------------------------------------------
# Accounts security (live)
# -----------------------------------------------------------------------------
# Key encrypting 2FA (TOTP) secrets and other sensitive account data at rest. REQUIRED for live.
# 32 random bytes: `openssl rand -hex 32` (format: see docs/LIVE.md). Losing it locks every 2FA
# user out; rotating it needs the re-encryption procedure in docs/DEPLOY.md.
SECRETS_KEY=
# Hours before a newly whitelisted withdrawal address can receive funds [server default; see docs/LIVE.md].
# WHITELIST_DELAY_HOURS=24
# Lifetime of a live-mode session in days [server default; see docs/LIVE.md].
# LIVE_SESSION_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Embedded wallets (Turnkey). All three of ORGANIZATION_ID / API_PUBLIC_KEY /
# API_PRIVATE_KEY are needed, or wallets and trading stay off. Use an API key
# scoped by Turnkey policies to signing for this organization only.
# -----------------------------------------------------------------------------
# TURNKEY_API_BASE_URL=https://api.turnkey.com
TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
# Development only: 32-byte hex key for locally encrypted dev keypairs. Ignored when NODE_ENV=production.
# LOCAL_KEYSTORE_KEY=

# -----------------------------------------------------------------------------
# Solana
# -----------------------------------------------------------------------------
# HTTPS JSON-RPC (Helius / Triton / QuickNode). Unset: balances, holders, deposits and trading are off.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# WebSocket RPC [derived from SOLANA_RPC_URL].
# SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# pump.fun / PumpSwap data feed [wss://pumpportal.fun/api/data].
# PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Tokens whose trades are streamed at once, least active dropped beyond it; min 100 [3000].
# LIVE_MAX_TRACKED_TOKENS=3000
# Jupiter swap API [https://lite-api.jup.ag; https://api.jup.ag when JUPITER_API_KEY is set].
# JUPITER_API_URL=https://api.jup.ag
JUPITER_API_KEY=
# Jito block engine for MEV-protected sends [https://mainnet.block-engine.jito.wtf].
# JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
# Gateways tried in order for ipfs:// token metadata [https://ipfs.io/ipfs/,https://cloudflare-ipfs.com/ipfs/].
# IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://cloudflare-ipfs.com/ipfs/

# -----------------------------------------------------------------------------
# Platform fees
# -----------------------------------------------------------------------------
# Fee on every swap in basis points, 0-300 [80 = 0.8%].
PLATFORM_FEE_BPS=80
# Solana wallet receiving fees (public address; unset = fees not collected, reported at boot).
FEE_WALLET_ADDRESS=
# EVM wallet (0x…) receiving fees on Base, Robinhood Chain, BNB Chain and Ethereum.
EVM_FEE_WALLET_ADDRESS=

# -----------------------------------------------------------------------------
# EVM chains (Base, Robinhood Chain, BNB Chain, Ethereum)
# -----------------------------------------------------------------------------
# Chains enabled in live mode, comma-separated [every supported EVM chain].
LIVE_CHAINS=sol,base,robinhood,bsc,eth
# Per chain: HTTP RPC (comma-separated, tried in order before the public fallbacks), WebSocket RPC
# for subscriptions (unset = poll over HTTP), private / MEV-protected endpoint for sends.
# Unset *_RPC_URL means rate-limited public RPCs only (reported at boot): not for production.
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# BASE_WS_URL=wss://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# BASE_PRIVATE_RPC_URL=
# Robinhood Chain: Alchemy is the officially recommended provider (copy the HTTPS and WSS
# endpoints of a Robinhood Chain mainnet app from the Alchemy dashboard).
ROBINHOOD_RPC_URL=
# ROBINHOOD_WS_URL=
# ROBINHOOD_PRIVATE_RPC_URL=
BSC_RPC_URL=
# BSC_WS_URL=
# BSC_PRIVATE_RPC_URL=
ETH_RPC_URL=
# ETH_WS_URL=
# ETH_PRIVATE_RPC_URL=
# KyberSwap aggregator [https://aggregator-api.kyberswap.com] and the client id sent with requests [trenchscope].
# KYBERSWAP_API_URL=https://aggregator-api.kyberswap.com
# KYBERSWAP_CLIENT_ID=trenchscope

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# /metrics: 0 = disabled [on]. Caddy blocks it from the internet either way.
# METRICS=1
# Bearer token Prometheus must send for /metrics (`openssl rand -hex 24`) [none: open].
METRICS_TOKEN=
# One JSON line per HTTP request on stdout (probes skipped); 1 = on [off].
# ACCESS_LOG=1
# Minimum level of the JSON logger: trace, debug, info, warn, error, fatal, silent [info].
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Backups (scripts/backup-db.ts)
# -----------------------------------------------------------------------------
# Where backups are written [DATA_DIR/backups] and how many are kept [14]. Copy them off the host too.
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14

# -----------------------------------------------------------------------------
# Demo-mode only (ignored in live mode; see demo.env.example)
# -----------------------------------------------------------------------------
# SIM_SEED=trenchscope
# WARMUP_MINUTES=90
# TRADE_LATENCY_MS=
