# docker compose interpolation for deploy/docker-compose.yml (copy to deploy/.env).
# Server settings and secrets do not go here: see live.env.example / demo.env.example.

# Public hostnames; their DNS A/AAAA records must point at this host before Caddy
# can obtain certificates (ports 80 and 443 reachable from the internet).
LIVE_DOMAIN=app.example.com
DEMO_DOMAIN=demo.example.com

# Contact for the ACME CA (expiry and incident notices).
ACME_EMAIL=ops@example.com

# Image tag compose builds / runs (e.g. a git sha or release tag, for rollbacks).
TRENCHSCOPE_VERSION=latest
