# Trenchscope DEMO deployment (simulator + paper trading). Copy to deploy/demo.env.
# It needs no secrets: never put live keys (Turnkey, SECRETS_KEY, RPC keys) here.
# MODE=demo and TRUST_PROXY=1 are set by docker-compose.yml. Every variable is
# documented in live.env.example.

# Seed of the deterministic simulator [trenchscope].
SIM_SEED=trenchscope
# Market history fast-forwarded on a fresh start, in minutes [90].
WARMUP_MINUTES=90
# Snapshot cadence in ms; 0 = no persistence [900000].
SNAPSHOT_EVERY_MS=900000
# Fixed simulated confirmation latency in ms [random 120-600].
# TRADE_LATENCY_MS=

# Per-IP abuse limits [30 / 60 / 20].
ACCOUNT_CREATIONS_PER_IP=30
LOGIN_ATTEMPTS_PER_IP=60
WS_CONNECTIONS_PER_IP=20

# Observability (see live.env.example).
METRICS_TOKEN=
# ACCESS_LOG=1
# LOG_LEVEL=info
